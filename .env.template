# sellertool 환경변수 템플릿
# 이 파일을 .env.local 로 복사하고 실제 값을 채우세요. 실제 키는 절대 커밋 금지.

# ── 네이버 개발자센터 (쇼핑 검색 + 데이터랩 트렌드) — 핵심, 없으면 분석 불가
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── Supabase (DB: 리포트/검색이력 저장, 인증 연동)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── 카카오 로그인 (next-auth KakaoProvider) — 선택, 준비되면 NEXT_PUBLIC_KAKAO_READY=true
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NEXT_PUBLIC_KAKAO_READY=false

# ── Anthropic (이미지 분석 /api/image-analyze) — 선택
ANTHROPIC_API_KEY=

# ── 기타 (선택)
NEXT_PUBLIC_SITE_URL=https://sellertool-kr.vercel.app
NEXT_PUBLIC_GA_ID=
